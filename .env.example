# Required by `pnpm run upload:bulletin`, `pnpm run purchase:dotns`, and
# `pnpm run contenthash:dotns`.
# Path to a password-protected Polkadot.js account JSON export. This path is
# resolved from the repository root; .bulletin/ is gitignored.
ACCOUNT_FILE=.bulletin/account.json

# Optional overrides
# BULLETIN_RPC=wss://bulletin-paseo.tservices.es:8443
# BULLETIN_BUILD_DIRECTORY=dist
# BULLETIN_UPLOAD_STATE_FILE=.bulletin/build-upload-state.json

# Optional DotNS PCF Devnet overrides
# DOTNS_ASSET_HUB_RPC=wss://asset-hub-paseo-rpc.n.dwellir.com/
# DOTNS_PURCHASE_STATE_FILE=.dotns/domain-purchase-state.json
